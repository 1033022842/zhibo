# kelymi 品牌清单（apply_brand.sh 读取的语义值；替换正则内置于脚本）
# 规则来源：2026-10-16 服务器人工打品牌的实测 diff（5c764de 基线）
SITE_NAME=Kelymi
WORDMARK_TEXT=kelymi.ai          # 页脚 logo：小写 kelymi + <em>.ai</em>
DOMAIN=kelymi.autos
SUPPORT_EMAIL=support@kelymi.autos
PWA_TITLE=Kelymi
# 社交链接 slug：sugusai → kelymiai（discord.gg / discord.com/invite / twitter.com/try / apply.workable.com）
# 资产（部署时拷入站点根 / assets/brand/）
ASSET_FAVICON=kelymi-favicon-v4.png        # 500x500
ASSET_TOUCH=apple-touch-icon-kelymi-v4.png # 180x180
ASSET_WORDMARK=kelymi-wordmark.png         # 434x110
ASSET_WORDMARK_2X=kelymi-wordmark@2x.png   # 410x104
ASSET_LOGO=kelymi-logo.png                 # 434x110（登录等页用）
ASSET_SHARE_CARD=share_card_kelymi.png     # 1200x630
# 注意：js/brand.js 由 kit 整文件覆盖（域名切换器 kelymi.autos/live/chat/me）；
# 上游 brand.js 逻辑变更时需同步重做 kit 内的 brand.js。
