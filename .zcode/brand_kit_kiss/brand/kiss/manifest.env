# kisss 品牌清单（apply_brand.sh 读取的语义值；替换正则内置于脚本）
# 规则来源：kelymi kit（2026-10-19 复制改字）；域名 kisss.ai（解析中，暂以 IP 访问）
SITE_NAME=Kisss
WORDMARK_TEXT=kisss.ai         # 页脚 logo：小写 kisss + <em>.ai</em>
DOMAIN=kisss.ai
SUPPORT_EMAIL=support@kisss.ai
PWA_TITLE=Kisss
# 社交链接 slug：sugusai → kisssai（discord.gg / discord.com/invite / twitter.com/try / apply.workable.com）
# 资产（部署时拷入站点根 / assets/brand/）
ASSET_FAVICON=kisss-favicon-v4.png            # 500x500
ASSET_TOUCH=apple-touch-icon-kisss-v4.png     # 180x180
ASSET_WORDMARK=kisss-wordmark.png             # 434x110
ASSET_WORDMARK_2X=kisss-wordmark@2x.png       # 410x104
ASSET_LOGO=kisss-logo.png                     # 434x110（登录等页用）
ASSET_SHARE_CARD=share_card_kisss.png         # 1200x630
# 注意：js/brand.js 由 kit 整文件覆盖（单域名版，仅声明 window.KISSS_BRAND）
# 图片为文字版视觉（Segoe UI Bold 渲染），拿到官方素材后直接替换同名文件即可
