APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[LANG]
default_lang = zh-cn

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = live_platform
USERNAME = root
PASSWORD = root
HOSTPORT = 3306
PREFIX = ba_
CHARSET = utf8mb4
DEBUG = true

[PAYOUT]
; 提现打款：manual=人工转账后后台登记 TxHash（默认）；auto=后台审核通过后由热钱包自动链上打款
MODE = manual
; 热钱包私钥（64 位十六进制，不带 0x）。留空则该网络只能人工打款，切勿提交到代码仓库
TRC20_KEY =
ERC20_KEY =
BEP20_KEY =
; TronGrid API Key（可选，配置后扫链/打款限流更宽松）
TRC20_API_KEY =

[STARPAY]
GATEWAY = https://api.star-pay.vip
MERCHANT_NO =
KEY =
PRODUCT = TRC20Buy
PRODUCTS = TRC20Buy,ERC20Buy,USDCERC20Buy,TRC20H5
NOTIFY_URL =
RETURN_URL =
