APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[LANG]
default_lang = zh-cn

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = live_platform
USERNAME = root
PASSWORD = root
HOSTPORT = 3306
PREFIX = ba_
CHARSET = utf8mb4
DEBUG = true

[PAYOUT]
; 提现打款：manual=人工转账后后台登记 TxHash（默认）；auto=后台审核通过后由热钱包自动链上打款
MODE = manual
; 热钱包私钥（64 位十六进制，不带 0x）。留空则该网络只能人工打款，切勿提交到代码仓库
TRC20_KEY =
ERC20_KEY =
BEP20_KEY =
; TronGrid API Key（可选，配置后扫链/打款限流更宽松）
TRC20_API_KEY =

[STARPAY]
GATEWAY = https://api.star-pay.vip
MERCHANT_NO =
KEY =
PRODUCT = TRC20Buy
PRODUCTS = TRC20Buy,ERC20Buy,USDCERC20Buy,TRC20H5
NOTIFY_URL =
RETURN_URL =

[SJHSLL]
; 铭森支付（微信/支付宝），文档 http://sjhsll.com/Home_Index_document.html
GATEWAY = http://sjhsll.com
MEMBERID =
KEY =
; 本站异步回调地址（换成各站自己的域名）
NOTIFY_URL = https://本站域名/api/v1/recharge/notifySjhsll
RETURN_URL = https://本站域名/ai/tokens.html
RETURN_URL_VIP = https://本站域名/ai/taocan.html
; 浏览器回跳入口：网关以 POST 回跳，必须走动态接口再 302 到上面的页面
RETURN_ENDPOINT = https://本站域名/api/v1/recharge/returnSjhsll
; 订单号前缀：SJ + 14 位时间 + 4 位随机 = 20 位（网关上限 20）
ORDER_PREFIX = SJ

[MKPAY]
; MKPay（巴西）代收网关，商户后台 https://br.mkpayeasy.com/admin-OSdkkq/
; signKey 需在商户后台「开发者管理」重置获取，平台不保存该密钥
GATEWAY = https://br.mkpayeasy.com
APPID = 697146150936
SIGNKEY =
; 本站异步回调地址（换成各站自己的域名）
NOTIFY_URL = https://本站域名/api/v1/recharge/notifyMkPay
; MKPay 订单号前缀：两站共用 appId，靠前缀保证商户订单号唯一（本站 MKS / hey girl MKH）
ORDER_PREFIX = MKS

[SKYTRADE]
; Skytrade 固定商品链接收款：金额→商品地址映射在 config/skytrade.php
; 第三方回调验签密钥：sign = md5(order_no + NOTIFY_SECRET)（小写），必须与第三方约定一致
NOTIFY_SECRET = 换成一段随机字符串
; 本站订单号前缀（与其它网关区分，便于对账）
ORDER_PREFIX = SKT
; 第三方商户标识：回调 JSON 里的 mit 必须与它一致
MERCHANT_ID = sugus
; 自定义金额商品页：各站 slug 不同（sugus=custom-amount / heygirl=custom-amount-jewelry），留空=未开通
; 未登录用户自选金额走此链接；网关最低金额 $10.99，与 RechargeService::CUSTOM_MIN_USD 保持一致
CUSTOM_URL = https://skytrade.cc/api/buy/custom-amount?mit=sugus
; 联调开关：1=允许完全没带签名的回调（只用于联调，生产必须 0）
ALLOW_UNSIGNED = 0
; 浏览器回跳页（第三方把 success/cancel 回跳地址配到 /api/v1/recharge/returnSkytrade）
RETURN_URL = /ai/purchasePoints.html
RETURN_URL_VIP = /ai/Subscriptions.html

[TELEGRAM]
; Telegram Login Widget（每品牌一个 bot；Allowed URLs 在 BotFather mini app → Edit Bot → Login Widget 里配全部站点域名）
; bot_username 不带 @，用于前端渲染 widget；bot_token 只存服务端验签，绝不发给前端
; 四站对应关系：sugus.ai / heygirl.live / kelymi.{autos,live,chat,me} / kisss.ai
BOT_USERNAME =
BOT_TOKEN =

[MEDIA]
; 素材独立存储 + 签名防盗链（详见 docs/素材独立存储与签名防盗.md）
; 两个开关默认 0 = 完全走本机 public/storage，行为与改造前一致
; 切换顺序：先迁素材 → STORAGE_ENABLED=1 → ENABLED=1
ENABLED = 0
STORAGE_ENABLED = 0
; 存储服务器对外地址（不含结尾斜杠）
ENDPOINT = https://155-103-194-69.sslip.io
; 本项目在共享桶里的前缀（4 个项目各一个：sugus / hey / proj3 / proj4）
PROJECT = sugus
; 与存储端 nginx secure_link_md5 里的密钥一致
SIGN_SECRET =
; 签名有效期与过期对齐粒度。桶必须 >= CDN 缓存 max-age，否则 URL 频繁变化，
; 每次变化都是新的缓存键 → CDN 全部 MISS、视频反复回源（3600 桶 = 每小时重拉一次）
; 现网四站统一：桶 7 天 + TTL 8 天（URL 每周轮换，实际有效 8~15 天）
SIGN_TTL = 691200
SIGN_BUCKET_SEC = 604800
LIST_CACHE_TTL = 60
; S3 写网关（存储服务器 nginx /s3/ → MinIO）
S3_ENDPOINT = https://155-103-194-69.sslip.io/s3
S3_PATH_MODE = key
BUCKET = sugus-media
REGION = us-east-1
ACCESS_KEY =
SECRET_KEY =
GATEWAY_KEY =
; TLS 校验：留空=校验；填 false 仅在自签证书时使用
S3_VERIFY =
