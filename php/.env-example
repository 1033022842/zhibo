APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[LANG]
default_lang = zh-cn

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = live_platform
USERNAME = root
PASSWORD = root
HOSTPORT = 3306
PREFIX = ba_
CHARSET = utf8mb4
DEBUG = true

[PAYOUT]
; 提现打款：manual=人工转账后后台登记 TxHash（默认）；auto=后台审核通过后由热钱包自动链上打款
MODE = manual
; 热钱包私钥（64 位十六进制，不带 0x）。留空则该网络只能人工打款，切勿提交到代码仓库
TRC20_KEY =
ERC20_KEY =
BEP20_KEY =
; TronGrid API Key（可选，配置后扫链/打款限流更宽松）
TRC20_API_KEY =

[STARPAY]
GATEWAY = https://api.star-pay.vip
MERCHANT_NO =
KEY =
PRODUCT = TRC20Buy
PRODUCTS = TRC20Buy,ERC20Buy,USDCERC20Buy,TRC20H5
NOTIFY_URL =
RETURN_URL =

[MKPAY]
; MKPay（巴西）代收网关，商户后台 https://br.mkpayeasy.com/admin-OSdkkq/
; signKey 需在商户后台「开发者管理」重置获取，平台不保存该密钥
GATEWAY = https://br.mkpayeasy.com
APPID = 697146150936
SIGNKEY =
; 本站异步回调地址（换成各站自己的域名）
NOTIFY_URL = https://本站域名/api/v1/recharge/notifyMkPay
; MKPay 订单号前缀：两站共用 appId，靠前缀保证商户订单号唯一（本站 MKS / hey girl MKH）
ORDER_PREFIX = MKS

[MEDIA]
; 素材独立存储 + 签名防盗链（详见 docs/素材独立存储与签名防盗.md）
; 两个开关默认 0 = 完全走本机 public/storage，行为与改造前一致
; 切换顺序：先迁素材 → STORAGE_ENABLED=1 → ENABLED=1
ENABLED = 0
STORAGE_ENABLED = 0
; 存储服务器对外地址（不含结尾斜杠）
ENDPOINT = https://155-103-194-69.sslip.io
; 本项目在共享桶里的前缀（4 个项目各一个：sugus / hey / proj3 / proj4）
PROJECT = sugus
; 与存储端 nginx secure_link_md5 里的密钥一致
SIGN_SECRET =
SIGN_TTL = 21600
SIGN_BUCKET_SEC = 3600
LIST_CACHE_TTL = 60
; S3 写网关（存储服务器 nginx /s3/ → MinIO）
S3_ENDPOINT = https://155-103-194-69.sslip.io/s3
S3_PATH_MODE = key
BUCKET = sugus-media
REGION = us-east-1
ACCESS_KEY =
SECRET_KEY =
GATEWAY_KEY =
; TLS 校验：留空=校验；填 false 仅在自签证书时使用
S3_VERIFY =
