	<!-- PAG Web SDK - 使用 type="module" 加载 -->
	<!-- 官方文档: https://pag.io/docs/zh-CN/web-play-pagfile.html -->
	<!-- 尝试使用 unpkg CDN 或其他方式加载 PAG -->
	<script type="module">
		// 尝试多个 CDN 源和不同的文件路径
		var PAG_CDN_SOURCES = [
			// 尝试 ESM 版本
			'https://unpkg.com/libpag@latest/lib/libpag.esm.js',
			'https://cdn.jsdelivr.net/npm/libpag@latest/lib/libpag.esm.js',
			// 尝试标准版本
			'https://unpkg.com/libpag@latest/lib/libpag.min.js',
			'https://cdn.jsdelivr.net/npm/libpag@latest/lib/libpag.min.js',
			// 尝试完整路径
			'https://unpkg.com/libpag@latest/lib/libpag.js',
			'https://cdn.jsdelivr.net/npm/libpag@latest/lib/libpag.js'
		];
		
		var currentSourceIndex = 0;
		
		function tryLoadPAG(sourceIndex) {
			if (sourceIndex >= PAG_CDN_SOURCES.length) {
				// 所有 CDN 都失败，尝试本地文件
				console.warn('所有 PAG CDN 加载失败，尝试本地文件');
				import('./assets/libpag/libpag.min.js').then(function(module) {
					handlePAGModule(module, '本地文件');
				}).catch(function(localError) {
					console.error('PAG 加载完全失败:', localError);
					if (window.onPAGError) {
						window.onPAGError(localError);
					}
				});
				return;
			}
			
			var url = PAG_CDN_SOURCES[sourceIndex];
			console.log('尝试加载 PAG 从:', url);
			
			import(url).then(function(module) {
				handlePAGModule(module, url);
			}).catch(function(error) {
				console.warn('PAG 加载失败 (' + url + '):', error.message);
				// 尝试下一个源
				tryLoadPAG(sourceIndex + 1);
			});
		}
		
		function handlePAGModule(module, source) {
			console.log('PAG 模块加载成功，来源:', source);
			console.log('原始模块:', module);
			console.log('模块类型:', typeof module);
			console.log('模块 keys:', Object.keys(module));
			
			// 尝试多种方式获取 PAG
			var libpag = null;
			
			// 方式1: default 导出
			if (module.default) {
				libpag = module.default;
				console.log('使用 module.default');
			}
			
			// 方式2: 直接使用 module
			if (!libpag && (module.PAGFile || module.PAGView)) {
				libpag = module;
				console.log('使用 module 本身');
			}
			
			// 方式3: 查找 PAG 或 libpag 属性
			if (!libpag && module.PAG) {
				libpag = module.PAG;
				console.log('使用 module.PAG');
			}
			
			if (!libpag && module.libpag) {
				libpag = module.libpag;
				console.log('使用 module.libpag');
			}
			
			// 方式4: 如果 module 本身有方法，直接使用
			if (!libpag && typeof module === 'object' && Object.keys(module).length > 0) {
				libpag = module;
				console.log('使用 module 对象（非空）');
			}
			
			if (libpag) {
				window.libpag = libpag;
				console.log('PAG 库已设置到 window.libpag');
				console.log('libpag 类型:', typeof libpag);
				console.log('libpag keys:', Object.keys(libpag));
				
				// 检查关键 API（按照官方文档，应该有 PAGInit 方法）
				var apiCheck = {
					hasPAGInit: typeof libpag.PAGInit === 'function',
					hasPAGFile: !!(libpag.PAGFile),
					hasPAGView: !!(libpag.PAGView),
					hasTypes: !!(libpag.types)
				};
				console.log('API 检查:', apiCheck);
				
				// 按照官方文档，libpag 应该有 PAGInit 方法
				if (!apiCheck.hasPAGInit) {
					console.warn('PAGInit 方法未找到，PAG 可能无法正常初始化');
				} else {
					console.log('✓ PAGInit 方法可用，可以正常初始化 PAG');
				}
				
				if (window.onPAGLoaded) {
					window.onPAGLoaded(window.libpag);
				}
			} else {
				console.error('无法从模块中提取 PAG 库');
				console.error('建议：请下载 PAG 库到本地 ./assets/libpag/libpag.min.js');
				console.error('下载地址：https://github.com/Tencent/libpag/releases');
				if (window.onPAGError) {
					window.onPAGError(new Error('PAG 模块结构不正确，请使用本地文件'));
				}
			}
		}
		
		// 开始加载
		tryLoadPAG(0);
	</script>
	<script src="./js/main.js"></script>
	<script src="./js/event.js"></script>

<title>Private Channel</title>
<style>
  /* styles.css */
body, html {
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
}
.bg {
  background: #131313;
  background-size: cover;
  background-repeat: no-repeat;
  background-position: center;
  width: 100%;
  height: 100%;
}

#video-container {
    position: relative;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 80px;
    padding-bottom: 200px;
}

#videoPlayer {
    position: relative;
    width: 100%;
    max-width: 760px;
}

#videoPlayer video {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    border-radius: 10px;
}

#user-info {
    position: relative; /* 相对于 gift-container 定位 */
    text-align: left; /* 左对齐 */
    font-size: 20px;
    color: #fff;
    padding: 10px 20px;
    margin-bottom: 10px; /* 与礼物列表的间距 */
    background: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    backdrop-filter: blur(10px);
	max-width: 760px;
	margin: 0 auto;
}

/* 礼物栏样式 */
#gift-container {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.5));
    backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 20px;
    z-index: 50;
    max-height: 300px;
    overflow-y: auto;
}

#gift-list {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
    max-width: 1200px;
    margin: 0 auto;
}

.gift-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    padding: 10px;
    border-radius: 10px;
    transition: all 0.3s ease;
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid transparent;
    min-width: 80px;
}

.gift-item:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-5px);
}

.gift-item:active {
    transform: translateY(0) scale(0.95);
}

.gift-image {
    width: 60px;
    height: 60px;
    object-fit: contain;
    margin-bottom: 8px;
    border-radius: 8px;
}

.gift-name {
    color: #fff;
    font-size: 12px;
    text-align: center;
    margin-bottom: 4px;
    font-weight: 500;
}

.gift-price {
    color: #F77389;
    font-size: 11px;
    font-weight: 600;
}

/* 礼物效果动画 */
.gift-effect {
    position: fixed;
    pointer-events: none;
    z-index: 1000;
    animation: giftFly 3s ease-out forwards;
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.8));
}

@keyframes giftFly {
    0% {
        opacity: 1;
        transform: translateY(0) scale(0.8) rotate(0deg);
    }
    25% {
        opacity: 1;
        transform: translateY(-50px) scale(1.2) rotate(10deg);
    }
    50% {
        opacity: 0.9;
        transform: translateY(-150px) scale(1.3) rotate(-10deg);
    }
    75% {
        opacity: 0.6;
        transform: translateY(-250px) scale(1.1) rotate(5deg);
    }
    100% {
        opacity: 0;
        transform: translateY(-350px) scale(0.6) rotate(0deg);
    }
}

/* PAG 动画层样式 */
#gift-animation-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateY(-5%); /* 向上移动 10% */
}

.gift-pag-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.gift-pag-container.center {
    align-items: center;
    justify-content: center;
}

.gift-pag-container.fullscreen {
    width: 100%;
    height: 100%;
}

.gift-pag-container.bottom {
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 20%;
}

.gift-pag-canvas {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
}

/* 视频动画样式 */
.gift-video-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
	width: 100%;
}

.gift-video-container.center {
    align-items: center;
    justify-content: center;
}

.gift-video-container.fullscreen {
    width: 100%;
    height: 100%;
}

.gift-video-container.bottom {
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 20%;
}

.gift-animation-video {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
    pointer-events: none;
}

/* Loading 动画样式 */
@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.animate-spin {
    animation: spin 1s linear infinite;
}

/* 自定义滚动条样式 */
#gift-container::-webkit-scrollbar {
    width: 6px;
}

#gift-container::-webkit-scrollbar-track {
    background: #333333;
    border-radius: 3px;
}

#gift-container::-webkit-scrollbar-thumb {
    background: #000000;
    border-radius: 3px;
}

#gift-container::-webkit-scrollbar-thumb:hover {
    background: #1a1a1a;
}

@media only screen and (min-width: 768px) {
    #videoPlayer video {
        height: 1100px;
    }
}

@media only screen and (max-width: 768px) {
    #head-btn-group {
        display: none;
    }
    #video-container {
        padding-top: 60px;
        padding-bottom: 180px;
    }
    .gift-item {
        min-width: 70px;
    }
    .gift-image {
        width: 50px;
        height: 50px;
    }
}
</style>
</head>
