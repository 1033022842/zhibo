	<!-- Loading Overlay -->
	<div id="loading-overlay" class="fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50" style="display: none;">
		<div class="bg-gray-900 bg-opacity-70 rounded-lg p-8 flex flex-col items-center">
			<div class="animate-spin rounded-full h-16 w-16 border-b-2 border-pink-500 mb-4" style="border-bottom: 2px pink solid;"></div>
			<div class="text-white text-lg font-medium">Loading...</div>
			<div id="loading-text" class="text-gray-400 text-sm mt-2">Loading video...</div>
		</div>
	</div>

	<!-- 视频容器 -->
	<div id="video-container">
		<div id="videoPlayer" style="position:relative;">
			<video id="videoA" 
				   controls autoplay loop muted playsinline preload="auto"
				   style="object-fit:cover;opacity:1;transition:opacity 0.5s;display:block;"></video>
			<!-- PAG 动画效果层 -->
			<div id="gift-animation-layer"></div>
		</div>
	</div>

	<!-- 礼物栏 -->
	<div id="gift-container">
		<div id="user-info" style="display:none;">
			<div class="user-balance">Balance: $0</div>
		</div>
		<div id="gift-list">
			<!-- 礼物列表将通过 JavaScript 动态加载 -->
		</div>
	</div>

	<!-- 充值提示 Modal -->
	<div id="need-recharge-modal" class="fixed top-[40%] w-[80%] mx-auto inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50" style="display: none;" onclick="closeRechargeModal()">
		<div class="bg-gray-900 bg-opacity-70 rounded-lg p-8 flex flex-col items-center" onclick="event.stopPropagation()">
			<div class="text-white text-lg font-medium">Insufficient balance</div>
			<div class="text-gray-400 text-sm mt-2">Your balance is insufficient to purchase this gift, please go to recharge.</div>
			<div class="flex gap-4 mt-4">
				<button class="bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-md text-sm font-medium transition-all duration-200" onclick="closeRechargeModal()">Cancel</button>
				<button class="bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-600 hover:to-purple-700 text-white px-4 py-2 rounded-md text-sm font-medium transition-all duration-200 transform hover:scale-105" onclick="location.href='./Subscriptions.html'">Go to recharge</button>
			</div>
		</div>
	</div>

	<input type="hidden" id="characterName" value="">
	<input type="hidden" id="defaultVideo" value="">

	<script>
	(()=>{
		var base = 'https://api.kisss.ai'
		var token = localStorage.getItem('token')
		var giftList = []
		
		function getParam(name) {  
			var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");  
			var r = location.search.substring(1).match(reg);  
			if (r != null) return decodeURI(decodeURI(r[2])); 
		}
		
		var id = getParam('id')
		
		// 显示loading
		function showLoading(text) {
			const loadingEl = document.getElementById('loading-overlay');
			const loadingText = document.getElementById('loading-text');
			if (loadingEl) {
				loadingEl.style.display = 'flex';
			}
			if (loadingText && text) {
				loadingText.textContent = text;
			}
		}
		
		// 隐藏loading
		function hideLoading() {
			const loadingEl = document.getElementById('loading-overlay');
			if (loadingEl) {
				loadingEl.style.display = 'none';
			}
		}

		// 检查token是否存在
		if(token) {
			var tokenExpire = localStorage.getItem('tokenExpire')
			if(tokenExpire) {
				var now = new Date().getTime()
				if(now > tokenExpire) {
					localStorage.removeItem('token')
					localStorage.removeItem('userInfo')
					location.reload()
				}
			}

			getUserInfo()
		} else {
			// 如果没有token，可以跳转到登录页或允许继续
			// location.href = './Login.html'
		}

		//获取用户信息
		function getUserInfo(){
			var token = localStorage.getItem('token')
			var headers = {}
			if(token) {
				headers = {
					token
				}
			}

			const settings = {
				"async": true,
				"crossDomain": true,
				"url":  base + "/api/user/user_info",
				"method": "POST",
				"headers": headers,
				"processData": false,
				"contentType": false,
				"mimeType": "multipart/form-data",
			};
			
			$.ajax(settings).done(function (response) {
				if(typeof(response) === 'string') {
					response = JSON.parse(response)
				}
				var res = response
				if(res.code === 1) {
					localStorage.setItem('userInfo', JSON.stringify(res.data))
					// 显示用户余额（样式已在 CSS 中定义）
					document.getElementById('user-info').style.display = 'block'
					document.getElementById('user-info').innerHTML = `
						<div class="user-balance">Balance: $${res.data.money}</div>
					`


					// location.reload()
				} else {
					layer.msg(res.msg);  
				}
			}).catch(error => {
				console.error(error)
				layer.msg('Failed to get user info');  
			})
		}
		// 加载角色默认视频
		function loadVideo(id) {
			showLoading('Loading video...');
			
			var token = localStorage.getItem('token')
			var headers = {}
			if(token) {
				headers = {
					token
				}
			}

			const settings = {
				"async": true,
				"crossDomain": true,
				"url": "https://websocket.trd.lat" + "/api/characters/" + id + "/default_video",
				"method": "get",
				"headers": headers,
				"processData": false,
				"contentType": false,
				"mimeType": "multipart/form-data",
			};
			
			$.ajax(settings).done(function (response) {
				if(typeof(response) === 'string') {
					response = JSON.parse(response)
				}
				var res = response
				if(res.code === 1) {
					var video = document.getElementById('videoA')
					if (video) {
						video.src = res.video_file
						document.getElementById('defaultVideo').value = res.video_file
						
						video.addEventListener('loadeddata', function() {
							console.log('视频加载完成');
							video.play();
							hideLoading();
						}, { once: true });
						
						video.addEventListener('error', function(e) {
							console.error('视频加载失败:', e);
							hideLoading();
						}, { once: true });
						
						setTimeout(function() {
							if (video.readyState < 2) {
								console.log('视频加载超时，强制隐藏loading');
								hideLoading();
							}
						}, 10000);
					} else {
						console.error('找不到 video 元素')
						hideLoading();
					}
				} else {
					layer.msg(res.msg)
					hideLoading();
				}
			}).catch(error => {
				console.error(error)
				hideLoading();
			})
		}

		// 加载礼物列表
		function loadGiftList() {
			var token = localStorage.getItem('token')
			var headers = {}
			if(token) {
				headers = {
					token
				}
			}

			const settings = {
				"async": true,
				"crossDomain": true,
				"url": base + "/api/common/giftlist",
				"method": "get",
				"headers": headers,
				"processData": false,
				"contentType": false,
			};
			
			$.ajax(settings).done(function (response) {
				if(typeof(response) === 'string') {
					response = JSON.parse(response)
				}
				var res = response
				if(res.code === 1 && res.data) {
					giftList = res.data
					renderGiftList(giftList)
				} else {
					console.error('加载礼物列表失败:', res.msg)
				}
			}).catch(error => {
				console.error('加载礼物列表错误:', error)
			})
		}

		// 渲染礼物列表
		function renderGiftList(gifts) {
			var giftListEl = document.getElementById('gift-list')
			if (!giftListEl) return
			
			giftListEl.innerHTML = ''
			
			gifts.forEach(function(gift) {
				var giftItem = document.createElement('div')
				giftItem.className = 'gift-item'
				giftItem.setAttribute('data-gift-id', gift.id)
				giftItem.setAttribute('data-gift-name', gift.name)
				giftItem.setAttribute('data-gift-price', gift.price)
				
				giftItem.innerHTML = `
					<img src="${gift.image}" alt="${gift.name}" class="gift-image">
					<div class="gift-name">${gift.name}</div>
					<div class="gift-price">$${gift.price}</div>
				`
				
				giftItem.addEventListener('click', function() {
					handleGiftClick(gift)
				})
				
				giftListEl.appendChild(giftItem)
			})
		}

		// 显示充值 Modal
		function showRechargeModal() {
			var modal = document.getElementById('need-recharge-modal')
			if (modal) {
				modal.style.display = 'flex'
			}
		}

		// 关闭充值 Modal
		function closeRechargeModal() {
			var modal = document.getElementById('need-recharge-modal')
			if (modal) {
				modal.style.display = 'none'
			}
		}

		// 将函数暴露到全局作用域，以便 HTML onclick 可以访问
		window.showRechargeModal = showRechargeModal
		window.closeRechargeModal = closeRechargeModal

		// 检查用户余额
		function checkUserBalance(giftPrice) {
			var userInfoStr = localStorage.getItem('userInfo')
			if (!userInfoStr) {
				// 如果没有用户信息，尝试获取
				getUserInfo()
				return false
			}
			
			try {
				var userInfo = JSON.parse(userInfoStr)
				var userBalance = parseFloat(userInfo.money || 0)
				var price = parseFloat(giftPrice || 0)
				
				return userBalance >= price
			} catch (error) {
				console.error('解析用户信息失败:', error)
				return false
			}
		}

		// 发送礼物订单到后端
		function submitGiftOrder(gift, callback) {
			var token = localStorage.getItem('token')
			var headers = {}
			if(token) {
				headers = {
					token
				}
			}

			const form = new FormData()
			form.append('gift_id', gift.id)
			form.append('character_id', id)

			const settings = {
				"async": true,
				"crossDomain": true,
				"url": base + "/api/user/submit_gift_order",
				"method": "POST",
				"headers": headers,
				"processData": false,
				"contentType": false,
				"mimeType": "multipart/form-data",
				"data": form
			};
			
			$.ajax(settings).done(function (response) {
				if(typeof(response) === 'string') {
					response = JSON.parse(response)
				}
				var res = response
				if(res.code === 1) {
					console.log('礼物订单提交成功')
					// 更新用户余额
					if (res.data && res.data.remaining_balance !== undefined) {
						var userInfoStr = localStorage.getItem('userInfo')
						if (userInfoStr) {
							try {
								var userInfo = JSON.parse(userInfoStr)
								userInfo.money = res.data.remaining_balance
								localStorage.setItem('userInfo', JSON.stringify(userInfo))
								// 更新显示的余额
								var userInfoEl = document.getElementById('user-info')
								if (userInfoEl) {
									userInfoEl.innerHTML = `
										<div class="user-balance">Balance: $${res.data.remaining_balance}</div>
									`
								}
							} catch (e) {
								console.error('更新用户信息失败:', e)
							}
						}
					}
					// 执行回调（播放礼物特效）
					if (callback && typeof callback === 'function') {
						callback()
					}
				} else {
					console.error('礼物订单提交失败:', res.msg)
					layer.msg(res.msg || '礼物订单提交失败')
				}
			}).catch(error => {
				console.error('发送礼物订单错误:', error)
				layer.msg('网络错误，请稍后重试')
			})
		}

		// 处理礼物点击
		function handleGiftClick(gift) {
			console.log('点击礼物:', gift)
			
			// 检查用户余额
			var giftPrice = parseFloat(gift.price || 0)
			if (giftPrice <= 0) {
				layer.msg('礼物价格无效')
				return
			}

			if (!checkUserBalance(giftPrice)) {
				// 余额不足，显示充值 modal
				showRechargeModal()
				return
			}

			// 余额足够，发送礼物订单请求
			submitGiftOrder(gift, function() {
				// 订单提交成功后，播放礼物特效
				createGiftEffect(gift)
			})
		}

		// PAG 动画播放队列管理
		var pagAnimationQueue = []
		var isPlayingPAG = false
		var PAG = null // PAG 模块引用
		
		// 视频动画播放队列管理
		var videoAnimationQueue = []
		var isPlayingVideo = false
		
		// 初始化 PAG 模块（按照官方文档：先加载 libpag，再调用 PAGInit）
		async function initPAG() {
			if (PAG) return PAG
			
			// 等待 libpag 加载完成
			if (typeof window.libpag === 'undefined') {
				await new Promise(function(resolve, reject) {
					var checkCount = 0
					var maxChecks = 150 // 15秒，每100ms检查一次
					
					// 设置加载完成回调
					window.onPAGLoaded = function() {
						window.onPAGLoaded = null
						resolve()
					}
					
					// 设置错误回调
					window.onPAGError = function(error) {
						window.onPAGError = null
						reject(error)
					}
					
					// 轮询检查（备用方案）
					var checkInterval = setInterval(function() {
						if (typeof window.libpag !== 'undefined') {
							clearInterval(checkInterval)
							if (window.onPAGLoaded) {
								window.onPAGLoaded = null
							}
							resolve()
						} else if (checkCount++ >= maxChecks) {
							clearInterval(checkInterval)
							if (window.onPAGError) {
								window.onPAGError = null
							}
							reject(new Error('PAG 加载超时'))
						}
					}, 100)
				})
			}
			
			// 检查 libpag 是否有 PAGInit 方法
			if (!window.libpag || typeof window.libpag.PAGInit !== 'function') {
				throw new Error('PAGInit 方法不可用')
			}
			
			// 按照官方文档调用 PAGInit 初始化 PAG
			try {
				PAG = await window.libpag.PAGInit()
				console.log('PAG 初始化成功:', {
					hasPAGFile: !!(PAG && PAG.PAGFile),
					hasPAGView: !!(PAG && PAG.PAGView),
					keys: PAG ? Object.keys(PAG).slice(0, 10) : []
				})
				return PAG
			} catch (error) {
				console.error('PAGInit 调用失败:', error)
				throw error
			}
		}
		
		// 检查 PAG 是否可用
		async function isPAGAvailable() {
			try {
				var pag = await initPAG()
				if (!pag) {
					console.log('PAG 模块未加载')
					return false
				}
				
				// 检查 PAG API 结构（按照官方文档：应该有 PAGFile 和 PAGView）
				var hasPAGFile = !!(pag.PAGFile)
				var hasPAGView = !!(pag.PAGView)
				
				if (!hasPAGFile || !hasPAGView) {
					console.log('PAG API 结构不匹配:', {
						hasPAGFile: hasPAGFile,
						hasPAGView: hasPAGView,
						pagKeys: Object.keys(pag || {})
					})
				}
				
				return hasPAGFile && hasPAGView
			} catch (error) {
				console.error('检查 PAG 可用性时出错:', error)
				return false
			}
		}
		
		// 播放 PAG 动画
		async function playPAGAnimation(gift) {
			var pagAvailable = await isPAGAvailable()
			if (!pagAvailable) {
				console.warn('PAG library not available, fallback to static animation')
				createStaticGiftEffect(gift)
				return
			}
			
			var animationLayer = document.getElementById('gift-animation-layer')
			if (!animationLayer) {
				console.error('Animation layer not found')
				createStaticGiftEffect(gift)
				return
			}
			
			var animation = gift.animation
			if (!animation || !animation.url) {
				console.warn('No animation URL provided, fallback to static animation')
				createStaticGiftEffect(gift)
				return
			}
			
			var container = null
			var canvas = null
			var pagView = null
			
			try {
				// 确保 PAG 已初始化（会调用 PAGInit）
				if (!PAG) {
					PAG = await initPAG()
				}
				
				if (!PAG || !PAG.PAGFile || !PAG.PAGView) {
					console.error('PAG API 不完整:', {
						hasPAG: !!PAG,
						hasPAGFile: !!(PAG && PAG.PAGFile),
						hasPAGView: !!(PAG && PAG.PAGView),
						availableKeys: PAG ? Object.keys(PAG) : []
					})
					throw new Error('PAG library API not available')
				}
				
				// 创建容器
				container = document.createElement('div')
				container.className = 'gift-pag-container'
				
				// 根据 position 设置样式
				var position = animation.position || 'center'
				container.classList.add(position)
				
				// 创建 canvas
				canvas = document.createElement('canvas')
				canvas.className = 'gift-pag-canvas'
				
				// 先添加到 DOM，再设置尺寸（PAG 需要 canvas 在 DOM 中）
				container.appendChild(canvas)
				animationLayer.appendChild(container)
				
				// 加载 PAG 文件（处理 CORS 问题）
				var pagUrl = animation.url
				var response = null
				var arrayBuffer = null
				
				// 检查 URL 是否是跨域的
				var isCrossOrigin = false
				var targetOrigin = null
				try {
					var urlObj = new URL(pagUrl, window.location.href)
					targetOrigin = urlObj.origin
					isCrossOrigin = targetOrigin !== window.location.origin
				} catch (e) {
					// URL 解析失败，可能是相对路径，视为同源
					isCrossOrigin = false
				}
				
				// 如果 URL 是 localhost:8049（后端服务器），且当前页面是 localhost:8080，需要处理 CORS
				if (isCrossOrigin && targetOrigin && targetOrigin.includes('localhost:8049')) {
					// 方案1: 尝试通过后端 API 代理（如果后端有代理接口）
					// 方案2: 直接使用 fetch，但需要后端配置 CORS 头
					console.log('检测到跨域 PAG 文件，尝试加载:', pagUrl)
					
					try {
						// 先尝试直接 fetch（如果后端已配置 CORS）
						response = await fetch(pagUrl, {
							mode: 'cors',
							credentials: 'omit'
						})
						
						if (!response.ok) {
							throw new Error('HTTP ' + response.status + ': ' + response.statusText)
						}
						
						arrayBuffer = await response.arrayBuffer()
					} catch (corsError) {
						// CORS 失败，尝试通过后端代理或使用相对路径
						console.warn('CORS 错误，尝试其他方式加载:', corsError.message)
						
						// 如果 URL 是完整路径，尝试提取相对路径
						try {
							var fullUrl = new URL(pagUrl)
							var relativePath = fullUrl.pathname
							
							// 如果路径以 /assets/ 开头，直接使用（假设后端支持）
							if (relativePath.startsWith('/assets/')) {
								// 尝试使用当前页面的 origin + 路径（如果后端在同一域名下）
								var sameOriginUrl = window.location.origin + relativePath
								console.log('尝试同源 URL:', sameOriginUrl)
								
								try {
									response = await fetch(sameOriginUrl)
									if (response.ok) {
										arrayBuffer = await response.arrayBuffer()
									} else {
										throw new Error('Same origin fetch failed')
									}
								} catch (e) {
									// 如果还是失败，抛出原始 CORS 错误
									throw new Error('CORS 错误：后端服务器 ' + targetOrigin + ' 需要配置 Access-Control-Allow-Origin 头。\n' +
										'或者将 PAG 文件放到前端服务器的同源路径下。\n' +
										'原始错误: ' + corsError.message)
								}
							} else {
								throw corsError
							}
						} catch (e) {
							throw new Error('无法加载 PAG 文件。CORS 错误：' + corsError.message + 
								'\n请确保后端服务器配置了 CORS 头，或者将 PAG 文件放到前端可访问的位置。')
						}
					}
				} else {
					// 同源请求或官方 CDN（通常已配置 CORS）
					response = await fetch(pagUrl, {
						mode: isCrossOrigin ? 'cors' : 'same-origin',
						credentials: 'omit'
					})
					
					if (!response.ok) {
						throw new Error('Failed to load PAG file: ' + response.statusText)
					}
					
					arrayBuffer = await response.arrayBuffer()
				}
				
				// 按照官方文档使用 PAG.PAGFile.load()
				var pagFile = await PAG.PAGFile.load(arrayBuffer)
				
				// 设置 canvas 尺寸（使用 PAG 文件的原始尺寸或配置的尺寸）
				if (animation.size) {
					canvas.width = animation.size.width || pagFile.width()
					canvas.height = animation.size.height || pagFile.height()
					canvas.style.width = canvas.width + 'px'
					canvas.style.height = canvas.height + 'px'
				} else {
					// 使用 PAG 文件的原始尺寸
					canvas.width = pagFile.width()
					canvas.height = pagFile.height()
					canvas.style.width = canvas.width + 'px'
					canvas.style.height = canvas.height + 'px'
				}
				
				// 按照官方文档使用 PAG.PAGView.init()
				pagView = await PAG.PAGView.init(pagFile, canvas)
				
				// 设置缩放模式（可选，如果 API 支持）
				if (pagView && pagView.setScaleMode) {
					// 尝试从 PAG 对象获取 ScaleMode，或者使用数字常量
					// 0=LetterBox, 1=Stretch, 2=Zoom, 3=ZoomOut
					try {
						if (PAG.ScaleMode && PAG.ScaleMode.LetterBox !== undefined) {
							pagView.setScaleMode(PAG.ScaleMode.LetterBox)
						} else {
							// 使用数字常量：0 = LetterBox
							pagView.setScaleMode(0)
						}
					} catch (e) {
						// 忽略错误，这个设置是可选的
						console.log('setScaleMode 失败，继续播放:', e)
					}
				}
				
				// 设置播放参数
				if (pagView.setRepeatCount) {
					pagView.setRepeatCount(1) // 播放1次
				}
				if (pagView.setProgress) {
					pagView.setProgress(0) // 从开始播放
				}
				
				// 设置超时保护，防止动画卡住
				var duration = animation.duration || 3000
				var timeoutId = null
				var isCleanedUp = false
				
				// 清理函数
				var cleanup = function() {
					if (isCleanedUp) return
					isCleanedUp = true
					
					if (timeoutId) {
						clearTimeout(timeoutId)
					}
					
					// 清理资源
					try {
						if (pagView && pagView.destroy) {
							pagView.destroy()
						}
					} catch (e) {
						console.error('Error destroying PAG view:', e)
					}
					
					if (container && container.parentNode) {
						container.parentNode.removeChild(container)
					}
					
					// 播放队列中的下一个动画
					isPlayingPAG = false
					if (pagAnimationQueue.length > 0) {
						var nextGift = pagAnimationQueue.shift()
						playPAGAnimation(nextGift)
					}
				}
				
				// 监听播放完成事件
				if (pagView.addListener) {
					pagView.addListener('onAnimationEnd', cleanup)
				} else if (pagView.onAnimationEnd) {
					// 备用方式
					pagView.onAnimationEnd = cleanup
				}
				
				// 设置超时保护
				timeoutId = setTimeout(function() {
					if (!isCleanedUp) {
						console.warn('PAG animation timeout, cleaning up')
						cleanup()
					}
				}, duration + 2000) // 比预期时长多2秒
				
				// 开始播放
				if (pagView.play) {
					await pagView.play()
				} else if (pagView.start) {
					await pagView.start()
				}
				
				isPlayingPAG = true
				
			} catch (error) {
				console.error('PAG animation error:', error)
				// 清理可能创建的元素
				if (container && container.parentNode) {
					container.parentNode.removeChild(container)
				}
				// 降级到静态动画
				createStaticGiftEffect(gift)
				isPlayingPAG = false
				// 继续播放队列
				if (pagAnimationQueue.length > 0) {
					var nextGift = pagAnimationQueue.shift()
					playPAGAnimation(nextGift)
				}
			}
		}
		
		// 播放视频动画（WebM 格式）
		async function playVideoAnimation(gift) {
			var animationLayer = document.getElementById('gift-animation-layer')
			if (!animationLayer) {
				console.error('Animation layer not found')
				createStaticGiftEffect(gift)
				return
			}
			
			var animation = gift.animation
			if (!animation || !animation.url) {
				console.warn('No animation URL provided, fallback to static animation')
				createStaticGiftEffect(gift)
				return
			}
			
			var container = null
			var video = null
			
			try {
				// 创建容器
				container = document.createElement('div')
				container.className = 'gift-video-container'
				
				// 根据 position 设置样式
				var position = animation.position || 'center'
				container.classList.add(position)
				
				// 创建 video 元素
				video = document.createElement('video')
				video.className = 'gift-animation-video'
				video.muted = true // 静音播放
				video.playsInline = true // iOS 内联播放
				video.loop = false // 不循环
				video.preload = 'auto'
				
				// 设置视频源
				video.src = animation.url
				
				// 设置视频尺寸
				if (animation.size) {
					// video.style.width = (animation.size.width || 400) + 'px'
					// video.style.height = (animation.size.height || 400) + 'px'
				} else {
					// 默认尺寸
					var videoPlayer = document.getElementById('videoPlayer')
					if (videoPlayer) {
						var rect = videoPlayer.getBoundingClientRect()
						// video.style.width = Math.min(400, rect.width) + 'px'
						// video.style.height = Math.min(400, rect.height) + 'px'
					}
				}
				
				container.appendChild(video)
				animationLayer.appendChild(container)
				
				// 设置超时保护
				var duration = animation.duration || 3000
				var timeoutId = null
				var isCleanedUp = false
				
				// 清理函数
				var cleanup = function() {
					if (isCleanedUp) return
					isCleanedUp = true
					
					if (timeoutId) {
						clearTimeout(timeoutId)
					}
					
					// 停止视频播放
					try {
						if (video) {
							video.pause()
							video.src = '' // 清空源，释放资源
							video.load() // 重置视频元素
						}
					} catch (e) {
						console.error('Error cleaning up video:', e)
					}
					
					// 移除 DOM 元素
					if (container && container.parentNode) {
						container.parentNode.removeChild(container)
					}
					
					// 播放队列中的下一个动画
					isPlayingVideo = false
					if (videoAnimationQueue.length > 0) {
						var nextGift = videoAnimationQueue.shift()
						playVideoAnimation(nextGift)
					}
				}
				
				// 监听播放完成事件
				video.addEventListener('ended', cleanup, { once: true })
				
				// 监听错误事件
				video.addEventListener('error', function(e) {
					console.error('Video animation error:', e)
					cleanup()
					// 降级到静态动画
					createStaticGiftEffect(gift)
				}, { once: true })
				
				// 设置超时保护
				timeoutId = setTimeout(function() {
					if (!isCleanedUp) {
						console.warn('Video animation timeout, cleaning up')
						cleanup()
					}
				}, duration + 2000) // 比预期时长多2秒
				
				// 开始播放
				isPlayingVideo = true
				
				try {
					await video.play()
					console.log('Video animation started')
				} catch (playError) {
					console.error('Video play failed:', playError)
					// 某些浏览器可能需要用户交互才能播放
					// 尝试静音播放
					video.muted = true
					try {
						await video.play()
					} catch (e) {
						console.error('Video play failed even with muted:', e)
						cleanup()
						createStaticGiftEffect(gift)
					}
				}
				
			} catch (error) {
				console.error('Video animation error:', error)
				// 清理可能创建的元素
				if (container && container.parentNode) {
					container.parentNode.removeChild(container)
				}
				// 降级到静态动画
				createStaticGiftEffect(gift)
				isPlayingVideo = false
				// 继续播放队列
				if (videoAnimationQueue.length > 0) {
					var nextGift = videoAnimationQueue.shift()
					playVideoAnimation(nextGift)
				}
			}
		}
		
		// 创建静态礼物效果（降级方案）
		function createStaticGiftEffect(gift) {
			var videoContainer = document.getElementById('video-container')
			if (!videoContainer) return
			
			// 创建效果元素
			var effect = document.createElement('div')
			effect.className = 'gift-effect'
			
			var img = document.createElement('img')
			img.src = gift.image
			img.style.width = '100px'
			img.style.height = '100px'
			img.style.objectFit = 'contain'
			img.style.borderRadius = '10px'
			
			// 添加礼物名称
			var nameDiv = document.createElement('div')
			nameDiv.style.color = '#fff'
			nameDiv.style.fontSize = '14px'
			nameDiv.style.fontWeight = 'bold'
			nameDiv.style.marginTop = '5px'
			nameDiv.style.textShadow = '0 0 5px rgba(0,0,0,0.8)'
			nameDiv.textContent = gift.name
			
			effect.appendChild(img)
			effect.appendChild(nameDiv)
			
			// 随机位置，从视频容器底部向上飞
			var containerRect = videoContainer.getBoundingClientRect()
			var randomX = Math.random() * (containerRect.width - 100)
			effect.style.left = (containerRect.left + randomX) + 'px'
			effect.style.top = (containerRect.bottom - 50) + 'px'
			
			document.body.appendChild(effect)
			
			// 3秒后移除元素
			setTimeout(function() {
				if (effect.parentNode) {
					effect.parentNode.removeChild(effect)
				}
			}, 3000)
		}
		
		// 创建礼物效果动画（主函数）
		function createGiftEffect(gift) {
			var animation = gift.animation
			
			if (!animation || !animation.url) {
				// 没有动画配置，使用静态效果
				createStaticGiftEffect(gift)
				return
			}
			
			// 根据动画类型选择播放方式
			if (animation.type === 'video') {
				// 视频动画（WebM 格式）
				if (isPlayingVideo) {
					videoAnimationQueue.push(gift)
					console.log('Video animation queued, current queue length:', videoAnimationQueue.length)
				} else {
					playVideoAnimation(gift)
				}
			} else if (animation.type === 'pag') {
				// PAG 动画（保留向后兼容）
				if (isPlayingPAG) {
					pagAnimationQueue.push(gift)
					console.log('PAG animation queued, current queue length:', pagAnimationQueue.length)
				} else {
					playPAGAnimation(gift)
				}
			} else {
				// 未知类型或没有指定类型，尝试根据 URL 判断
				var url = animation.url.toLowerCase()
				if (url.endsWith('.webm') || url.endsWith('.mp4') || url.endsWith('.mov')) {
					// 视频文件，使用视频播放
					if (isPlayingVideo) {
						videoAnimationQueue.push(gift)
					} else {
						playVideoAnimation(gift)
					}
				} else if (url.endsWith('.pag')) {
					// PAG 文件，使用 PAG 播放
					if (isPlayingPAG) {
						pagAnimationQueue.push(gift)
					} else {
						playPAGAnimation(gift)
					}
				} else {
					// 无法识别，使用静态效果
					console.warn('Unknown animation type, fallback to static effect')
					createStaticGiftEffect(gift)
				}
			}
		}

		// 发送礼物到服务器（可选）
		function sendGiftToServer(gift) {
			var token = localStorage.getItem('token')
			var headers = {}
			if(token) {
				headers = {
					token
				}
			}

			const settings = {
				"async": true,
				"crossDomain": true,
				"url": base + "/api/gift/send", // 根据实际API调整
				"method": "POST",
				"headers": headers,
				"data": {
					character_id: id,
					gift_id: gift.id,
					gift_price: gift.price
				},
				"processData": true,
				"contentType": "application/json",
			};
			
			$.ajax(settings).done(function (response) {
				if(typeof(response) === 'string') {
					response = JSON.parse(response)
				}
				var res = response
				if(res.code === 1) {
					console.log('礼物发送成功')
				} else {
					console.error('礼物发送失败:', res.msg)
					layer.msg(res.msg)
				}
			}).catch(error => {
				console.error('发送礼物错误:', error)
			})
		}

		// 确保视频自动播放
		document.addEventListener('DOMContentLoaded', function() {
			const video = document.getElementById('videoA');
			
			function playVideo() {
				if (video) {
					video.muted = true;
					video.play().then(function() {
						console.log('视频开始自动播放');
					}).catch(function(error) {
						console.log('自动播放失败:', error);
						document.addEventListener('click', function() {
							video.play();
						}, { once: true });
					});
				}
			}
			
			playVideo();
			
			if (video) {
				video.addEventListener('loadeddata', function() {
					playVideo();
				});
				
				video.addEventListener('error', function(e) {
					console.log('视频加载错误:', e);
				});
			}
		});

		// 初始化
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', function() {
				if (id) {
					loadVideo(id)
				}
				loadGiftList()
			})
		} else {
			if (id) {
				loadVideo(id)
			}
			loadGiftList()
		}
	})()
	</script>
</body>
</html>

